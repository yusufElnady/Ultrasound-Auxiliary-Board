	(text "Output voltage from LNA+VGA:\n-1.125 -> 1.125 (2.25v swing)\n\nInput voltage range for the MCU's ADC:\n0 -> 3.3 (3.3v swing)\n\nThe differential opamp configuration\nshifts the signal and amplifies it with\na factor of 1.444 (3.9/2.7) to achieve\na swing of 3.25.\n\n"
		(exclude_from_sim no)
		(at 258.826 241.554 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "67eab45f-2aed-46c1-81f1-d24b574582ca")
	)
	(text "2nd order filter values were recommended\nby a TI application note (spraa88a), specs:\n- PWM frequency = 5 MHz\n- Cut-off frequency = 107.3 KHz\n- Damping ratio = 0.675 (over-damped but response time = 3 uSec)"
		(exclude_from_sim no)
		(at 15.748 252.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b9fbe723-16ae-4863-a743-53c1d8d978ea")
	)
	(text "0.5k would draw 10mA, acceptable."
		(exclude_from_sim no)
		(at 32.512 177.292 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f800fbbb-4638-4f37-9f83-250199a50014")
	)
