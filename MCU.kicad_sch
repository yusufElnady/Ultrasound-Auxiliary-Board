	(text "The crystal is required (@ 16MHz):\n- To have a drive level of >= 1mW (a damping resistor is used)\n- Have maximum ESR of 75 Ohms (50 is used)\n- 12pF < Cl < 24pF (18pF is used)"
		(exclude_from_sim no)
		(at 16.51 56.896 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3528c85c-4e49-47a4-9aca-27441f3e32f9")
	)
	(text "Each pin should have a 0.1uF cap.\nThe pins should have a bulk capacitance\nof 10uF < sum < 22uF. (20.4uF is implemented)"
		(exclude_from_sim no)
		(at 22.352 122.428 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "36dbc53c-f212-4201-9320-1bdb75ce8a26")
	)
	(text "Each pin should have a 0.1uF cap.\nA 10uF cap is added for the VDDA pin."
		(exclude_from_sim no)
		(at 22.352 89.408 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "42e5d910-a7c9-4112-8809-968f9bb1f7b5")
	)
	(text "The debugger to be used is\nthe XDS110 debugger (recommended by TI)."
		(exclude_from_sim no)
		(at 183.515 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6eb212e1-4fe1-4573-9268-651f90d4f7b3")
	)
	(text "At least 2.2uF is recommended at the\nVref_hi pin, 10uF is used."
		(exclude_from_sim no)
		(at 279.4 236.474 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "894419a3-cd9a-4d91-9a33-c35fc0cc69c6")
	)
	(text "1K resistors are placed at pulser lines\nto limit current t0 3.3mA per pin."
		(exclude_from_sim no)
		(at 293.624 160.782 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a5d1cef9-2791-46d4-86da-5ed4bf5ed9ec")
	)
	(text "The reset pin is active low.\n\nThe decoupling capacitor MUST NOT\nbe greater than 100uF or else it\nwill interfere with the watchdog\nreset functionality."
		(exclude_from_sim no)
		(at 177.8 203.708 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c852786c-ca95-4671-9820-cf274f578c98")
	)
	(text "Flash test pins (whatever they are).\nMust be left unconnected."
		(exclude_from_sim no)
		(at 347.218 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d29167d6-aeb3-4c61-9800-8b89a682845e")
	)
	(text "C1 = C2 = 2(C_load - C_stray) = 2 (18-2) = 32pF\n"
		(exclude_from_sim no)
		(at 42.418 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fbd20eea-dd9a-48b9-9eb2-f807533fc1ac")
	)
